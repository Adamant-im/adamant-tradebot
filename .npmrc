# Babel 8 + Jest 30: babel-preset-current-node-syntax still pins @babel/plugin-syntax-*@7
# with peer @babel/core ^7; Babel 8 is compatible at runtime but fails strict peer resolution.
legacy-peer-deps=true

# Supply-chain quarantine: resolve only versions published at least 7 days ago.
# npm >=11.10 enforces it. npm 10 (bundled with Node.js 22) ignores it, so `npm ci` keeps using the lockfile as is.
# For an approved early adoption, add the package to min-release-age-exclude and record the decision in the PR.
min-release-age=7
